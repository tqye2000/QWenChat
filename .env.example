# ─────────────────────────────────────────────────────────────────────────────
# Single place to choose which model everything uses.
# Read by serve_qwen.py, run_qwen.py and download_model.py (via python-dotenv).
#
# Set MODEL to any Hugging Face model id. Examples:
#   MODEL=Qwen/Qwen3-1.7B
#   MODEL=Qwen/Qwen3-8B
#   MODEL=Qwen/Qwen3-32B
# ─────────────────────────────────────────────────────────────────────────────
MODEL=Qwen/Qwen3.6-27B

# ── Optional overrides (uncomment to change; otherwise script defaults apply) ──
# Port the inference server listens on.
# QWEN_PORT=8000
# Shard a large model across all GPUs: 1 = yes (default), 0 = single GPU.
# QWEN_MULTI_GPU=1
# Force offline/online: 1 = offline, 0 = online. Unset = auto-detect.
# QWEN_OFFLINE=
# Attention backend: flash_attention_2 | sdpa | eager | none. Unset = auto.
# QWEN_ATTN=
# Reasoning mode: on | off | auto. Unset = auto.
# QWEN_REASONING=auto
# OpenAI-compatible endpoint used by the chat client.
# OPENAI_API_BASE=http://localhost:8000/v1
# OPENAI_API_KEY=EMPTY
